{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio: full-stack web application",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green \"npm run dev -w @portfolio/server\" \"npm run dev -w @portfolio/client\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @portfolio/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @portfolio/server --",
    "db:rollback": "npm run db:rollback -w @portfolio/server --",
    "db:status": "npm run db:status -w @portfolio/server --",
    "db:seed": "npm run db:seed -w @portfolio/server --",
    "db:reset": "npm run db:reset -w @portfolio/server --",
    "db:import-messages": "npm run db:import-messages -w @portfolio/server --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
