{
  "name": "@portfolio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for the portfolio",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "db:migrate": "node src/db/cli.js migrate",
    "db:rollback": "node src/db/cli.js rollback",
