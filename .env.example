# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=3000
# What the server writes to its log: fatal, error, warn, info, debug, trace or silent.
# Leave empty for the default: debug while developing, info in production.
LOG_LEVEL=
# Public URL of the site. Required when NODE_ENV=production. The client build also reads it
# to write sitemap.xml and the link-preview tags, so it must be the https address people use
# (for example https://your-name.pages.dev); with anything else those files are skipped.
SITE_URL=http://localhost:5173
# Number of reverse proxies in front of the server (0 when running locally).
# Set it when deployed behind one, or the contact rate limit sees the proxy's IP.
TRUST_PROXY_HOPS=0

# --- Contact form ---
# Long random secret (16+ characters) used to hash visitor IPs before storing them.
# Leave empty to store no IP information. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
IP_HASH_SALT=
# Only used when DATABASE_URL is not set (local development): where messages are saved
# (default: server/data/contact-messages.jsonl). With a database they go into PostgreSQL.
CONTACT_STORE_PATH=

# Email notification when someone sends a message (optional). Leave SMTP_HOST empty to
# turn it off; messages are still saved. Use an app password from your email provider,
# never your normal account password, and never commit the real values.
SMTP_HOST=
# 587 uses STARTTLS; 465 uses TLS from the start (SMTP_SECURE then defaults to true).
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Where notifications are delivered, and who they appear to come from (default: SMTP_USER).
CONTACT_NOTIFY_TO=
CONTACT_MAIL_FROM=

# --- Database ---
# The three POSTGRES_* values are read by docker-compose.yml to create the local database.
# They only take effect the FIRST time the container is created; to change the password
# afterwards run `docker compose down -v` (this deletes the local data) and start again.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=portfolio
# Must use the same user, password and database name as above. Required in production.
# A password with special characters (@ : / # ?) must be percent-encoded in this address.
DATABASE_URL=postgres://portfolio:change_me_locally@localhost:5432/portfolio
# Used only by the database tests (npm test skips them when empty). Point it at a database
# that may be filled and emptied freely, never at real data. Each test file works in its own
# temporary schema and removes it afterwards.
TEST_DATABASE_URL=
